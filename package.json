    "start": "node server/index.mjs",
    "smoke": "node ops/smoke.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.32.0",
    "@babylonjs/loaders": "9.32.0",
    "express": "5.3.0"
  },
